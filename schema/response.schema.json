{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hn2.github.io/adapter-protocol/schema/1.0.0/response",
  "title": "AdapterResponse",
  "description": "Response object returned by VendorAdapter.call().",
  "type": "object",
  "required": ["content", "model", "usage", "costUsd"],
  "additionalProperties": false,
  "properties": {
    "content": {
      "type": "string",
      "description": "The generated text output."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier as returned by the upstream provider."
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false,
      "description": "Token usage for billing and context-window tracking.",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "costUsd": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated cost in US dollars. Adapters that cannot compute cost MUST return 0."
    },
    "stopReason": {
      "type": "string",
      "description": "Why generation stopped.",
      "enum": ["end_turn", "max_tokens", "tool_use", "stop_sequence", "content_filtered"]
    },
    "toolCalls": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Tool calls requested by the model. Only present when stopReason is 'tool_use'."
    }
  }
}
